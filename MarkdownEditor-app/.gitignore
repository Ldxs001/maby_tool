__pycache__/
*.pyc
document.html
document.paged.html
.playwright-cli/

# 运行缓存（WebView2 运行时/日志，首次运行自动生成，不入版本库）
# 注意：必须锚定到本目录根（前导 /），否则会误伤
# python/Lib/site-packages/pythonnet/runtime/ 下 pythonnet 的原生桥接 DLL，
# 导致内嵌窗口因缺失 Python.Runtime.dll 而无法启动。
# 运行缓存：整目录忽略，但 run 库要入库（唯一位于 runtime/runs/，示例随包分发）
/runtime/*
!/runtime/runs/
!/runtime/runs/**
# 反选会连 __pycache__ 一起放行，必须再排掉（规则自上而下，后覆盖前）
/runtime/runs/__pycache__/

# 开发临时产物
_tmp_*

# 开发机私货（分发清单·六：运行时自动生成/开发工具，不入库）
.codeartsdoer/
.playwright-cli/

# 安装包构建产物（installer/ 源码入库；staging 与 Setup.exe 产物不入库，仅挂 Release）
/_setup_staging/
/_setup_out/

# 预编译的系统集成入口（构建期由 installer/_build_installer.py 生成，随包分发）
# 不入库：二进制入库会让每次构建都产生无意义的二进制 diff。
/MarkdownEditor.exe
/UninstallMDEditor.exe

# 视频合成中间产物（_video28）：合成源码/字体/示例图/静帧入库，
# 配音 wav、录制帧、中间视频、合成音频、录制日志不入库（合计约 27MB）
/_video28/tts/
/_video28/raw28/
/_video28/frames/
/_video28/*.m4a
/_video28/video_only.mp4
/_video28/_rec.log
/_video28/_tts.log
/installer/_msix_identity.json
/_setup_msix_stage/
